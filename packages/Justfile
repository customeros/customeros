# Common module paths
server_modules := "server/customer-os-postgres-repository server/customer-os-common-module server/events-subscribers server/customer-os-api server/customer-os-neo4j-repository server/customer-os-platform-admin-api server/customer-os-webhooks server/events server/events-processing-platform server/events-processing-platform-subscribers server/file-store-api server/settings-api server/user-admin-api server/validation-api server/enrichment-api"

runner_modules := "runner/customer-os-data-upkeeper runner/sync-gmail-raw runner/sync-gmail runner/sync-customer-os-data runner/sync-slack runner/customer-os-dedup runner/integrity-checker"

bin_dir := "bin"

# Build all services
build-all: ensure-bin-dir
    #!/usr/bin/env bash
    echo "Building all services in parallel..."
    
    # Function to build a single module
    build_module() {
        local module=$1
        local type=$2  # "server" or "runner"
        
        if [[ ! -d "$module" ]]; then
            echo "Skipping $module - directory not found"
            return
        fi
        
        # Look for *main.go files only in the root of the module
        local main_file=$(find "$module" -maxdepth 1 -name "*main.go" | head -n 1)
        if [[ -z "$main_file" ]]; then
            echo "No main.go found in root of $module - skipping"
            return
        fi
        
        echo "Building $module using $main_file"
        binary_name=$(basename $module)
        (cd "$module" && go build -o "../../{{bin_dir}}/$type/$binary_name" "$(basename $main_file)") || exit 1
    }
    
    # Export the function so it's available to parallel processes
    export -f build_module
    
    # Start building server modules in parallel
    echo "Building server services..."
    pids=()
    for module in {{server_modules}}; do
        build_module "$module" "server" &
        pids+=($!)
    done
    
    # Start building runner modules in parallel
    echo "Building runner services..."
    for module in {{runner_modules}}; do
        build_module "$module" "runner" &
        pids+=($!)
    done
    
    # Wait for all builds to complete
    failed=0
    for pid in "${pids[@]}"; do
        if ! wait $pid; then
            echo "Build process $pid failed"
            failed=1
        fi
    done
    
    if [ $failed -eq 0 ]; then
        echo "All services built successfully!"
    else
        echo "Some builds failed"
        exit 1
    fi

# Ensure binary output directories exist
ensure-bin-dir:
    mkdir -p {{bin_dir}}/server {{bin_dir}}/runner

# Build a specific service
build SERVICE:
    @if [ -f "{{SERVICE}}/main.go" ]; then \
        mkdir -p {{bin_dir}}/$(dirname {{SERVICE}}); \
        go build -o {{bin_dir}}/{{SERVICE}} {{SERVICE}}/main.go; \
    else \
        echo "No main.go found in {{SERVICE}}"; \
        exit 1; \
    fi

# Build and tidy everything (useful for CI)
ci: tidy-all build-all

# Clean build artifacts
clean:
	rm -rf {{bin_dir}}
	rm -rf *.log
	rm -rf *.pid

logs:
    tail -f admin-api.log api.log events-subscribers.log

# Show outdated dependencies for all modules
outdated:
    #!/usr/bin/env bash
    echo "Checking outdated dependencies..."
    for module in {{server_modules}} {{runner_modules}}; do
        if [[ ! -d "$module" ]]; then
            continue
        fi
        echo -e "\n=== $module ==="
        (cd "$module" && go list -u -m all | grep -v "indirect" | grep "\[" || echo "All dependencies are up to date")
    done

ps:
	cd ../deployment && podman-compose ps

restart-api:
    pkill -f "customer-os-platform-admin-api" || true
    cd ./server/customer-os-platform-admin-api && go run . > ../../admin-api.log 2>&1 & echo $$! > admin-api.pid
    pkill -f "customer-os-api" || true
    cd ./server/customer-os-api && go run . > ../../api.log 2>&1 & echo $$! > api.pid
    echo "CustomerOS API restarted"

start:
	cd ../deployment && podman-compose up rabbitmq jaeger postgres postgres-sidecar neo4j eventstore customer-os-platform-admin-api -d

start-api:
    cd ./server/customer-os-platform-admin-api && go run . > ../../admin-api.log 2>&1 & echo $$! > admin-api.pid
    cd ./server/customer-os-api && go run . > ../../api.log 2>&1 & echo $$! > api.pid
    echo "Services started."

start-api-debug:
    cd ./server/customer-os-api && dlv debug --headless --listen=:2345 --api-version=2 .

start-be:
	cd ../deployment && podman-compose up -d

start-events:
    cd ./server/events-subscribers && go run . > ../../events-subscribers.log 2>&1 & echo $$! > events-subscribers.pid

start-fe:
    cd ../deployment && podman-compose up user-admin-api settings-api -d
    cd ./apps/frontera && npm run dev

stop:
	kill `cat api.pid` 2>/dev/null || true
	kill `cat events-subscribers.pid` 2>/dev/null || true
	rm -f *.pid
	cd ../deployment && podman-compose down rabbitmq jaeger postgres postgres-sidecar neo4j eventstore customer-os-platform-admin-api user-admin-api settings-api

test-flow SERVICE:
	python3 server/customer-os-api/test/flows/{{SERVICE}}_test.py

# Run tests for a specific service
test SERVICE:
    @if [[ ! -d "{{SERVICE}}" ]]; then \
        echo "Service directory not found: {{SERVICE}}"; \
        exit 1; \
    fi; \
    cd "{{SERVICE}}" && go test -v ./...

# Tidy all Go modules
tidy-all:
    #!/usr/bin/env bash
    echo "Tidying server modules..."
    for module in {{server_modules}}; do
        echo "Tidying $module"
        (cd $module && go mod tidy) || exit 1
    done
    
    echo "Tidying runner modules..."
    for module in {{runner_modules}}; do
        echo "Tidying $module"
        (cd $module && go mod tidy) || exit 1
    done
    
    echo "All modules tidied successfully!"

# Tidy a specific module
tidy MODULE:
    @cd {{MODULE}} && go mod tidy

# Update specific dependency across all modules
update dep:
    #!/usr/bin/env bash
    echo "Updating {{dep}} in all modules..."
    for module in {{server_modules}} {{runner_modules}}; do
        if [[ ! -d "$module" ]]; then
            continue
        fi
        echo "=== Updating {{dep}} in $module ==="
        (cd "$module" && \
         go get -u {{dep}} && \
         go mod tidy)
    done

