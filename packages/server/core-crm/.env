OPENLINE_POSTGRES_HOST=localhost
OPENLINE_POSTGRES_PORT=5555
OPENLINE_POSTGRES_USER=postgres
OPENLINE_POSTGRES_PASSWORD=password
OPENLINE_POSTGRES_DB_NAME=openline
OPENLINE_POSTGRES_MAX_CONN=50
OPENLINE_POSTGRES_MAX_IDLE_CONN=25
OPENLINE_POSTGRES_CONN_MAX_LIFETIME=5
