APP_PORT="8080"

POSTGRES_HOST=localhost
POSTGRES_PORT=5555
POSTGRES_READ_PORT=5555
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=openline
POSTGRES_MAX_CONN=50
POSTGRES_MAX_IDLE_CONN=25
POSTGRES_CONN_MAX_LIFETIME=5
POSTGRES_LOG_LEVEL=INFO

WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_READ_PORT=5556
WAREHOUSE_DB_WRITE_PORT=5556
WAREHOUSE_DB_USER=postgres
WAREHOUSE_DB_PASSWORD=password
WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_MAX_CONN=20
WAREHOUSE_DB_MAX_IDLE_CONN=10
WAREHOUSE_DB_CONN_MAX_LIFETIME=5
WAREHOUSE_DB_LOG_LEVEL=INFO

NEO4J_TARGET=neo4j://127.0.0.1:7687
NEO4J_AUTH_USER=neo4j
NEO4J_AUTH_PWD=password

NATS_NODE_1_URL=localhost:4222

# valid log values (PANIC, FATAL, ERROR, WARN, INFO, DEBUG)
LOGGER_LEVEL=DEBUG
LOGGER_DEV_MODE=true
LOGGER_ENCODER=console

OTEL_ENABLED=true
OTEL_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=core-crm
OTEL_TIMEOUT=30

