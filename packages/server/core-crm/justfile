proto_dir := "../proto"

build:
    go build -o .bin/app .

db:
    pgcli postgresql://postgres:password@localhost:5555/mailstack

debug:
    dlv debug . -- server

gen-api:
    go run github.com/99designs/gqlgen generate --config ./api/graphql/gqlgen.yml

gen-proto:
    find {{proto_dir}} -name "*.proto" -type f -exec \
    protoc \
    --proto_path={{proto_dir}} \
    --go_out=./proto/pb \
    --go_opt=paths=source_relative \
    --go-grpc_out=./proto/pb \
    --go-grpc_opt=module=github.com/customeros/customeros/packages/server/core-crm/proto/pb \
    {} \;

migrate:
    go run main.go migrate

run:
    go run main.go server

tidy:
    go mod tidy

