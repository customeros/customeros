# Build stage
FROM golang:1.24.2-alpine3.21 AS builder

# Set the working directory
WORKDIR /app

# Set environment variables for optimized builds
ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=arm64

# Copy go.mod and go.sum first to leverage Docker cache
COPY go.mod go.sum ./
RUN go mod download

# Copy the source code
COPY ./ ./
COPY ../customer-os-common-module /customer-os-common-module/

# Build the application
RUN go mod tidy && \
    go build -ldflags="-s -w" -o /go/bin/app .

# Final stage - using standard distroless (no debug variant needed)
FROM gcr.io/distroless/static:nonroot

# Set the working directory
WORKDIR /app

# Copy the binary and required files
COPY --from=builder /go/bin/app ./app
COPY --from=builder /app/.env ./.env

# Use nonroot user
USER nonroot:nonroot

# Run the application directly
ENTRYPOINT ["/app/app"]

