# Build stage
FROM --platform=$BUILDPLATFORM golang:1.23-alpine AS builder

# Set the working directory
WORKDIR /app

# Set environment variables for optimized builds
ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=arm64

# Copy go.mod and go.sum first to leverage Docker cache
COPY packages/server/leads/go.mod packages/server/leads/go.sum ./
RUN go mod download

# Copy the source code
COPY packages/server/leads/ ./

# Build the application
RUN go mod tidy && \
    go build -ldflags="-s -w" -o /go/bin/app .

# Final stage - using standard distroless (no debug variant needed)
FROM --platform=linux/arm64 gcr.io/distroless/static:nonroot

# Set the working directory
WORKDIR /app

# Copy the binary and required files
COPY --from=builder /go/bin/app ./app
COPY --from=builder /app/.env ./.env

# Use nonroot user
USER nonroot:nonroot

# Run the application directly
ENTRYPOINT ["/app/app"]
