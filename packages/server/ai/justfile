proto_dir := "../proto"

build:
    go build -o .bin/app .

db:
    pgcli postgresql://postgres:password@localhost:5555/ai

debug:
    dlv debug . -- server

gen-proto:
    find {{proto_dir}} -name "*.proto" -type f -exec \
    protoc \
    --proto_path={{proto_dir}} \
    --go_out=./internal/proto/pb \
    --go_opt=paths=source_relative \
    {} \;


run:
    go run main.go

tidy:
    go mod tidy

