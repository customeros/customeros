extend type Query {
    tags: [Tag!]! @hasRole(roles: [ADMIN, USER]) @hasTenant @deprecated(reason: "Use tags_ByEntityType")
    tags_ByEntityType(entityType: EntityType!): [Tag!]! @hasRole(roles: [ADMIN, USER]) @hasTenant
}

extend type Mutation {
    tag_Create(input: TagInput!): Tag!
    tag_Update(input: TagUpdateInput!): Tag
    tag_Delete(id: ID!): Result
}

type Tag {
    metadata:   Metadata!
    name:       String!
    entityType: EntityType!
}

input TagInput {
    name:           String!
    appSource:      String
    entityType:     EntityType = ORGANIZATION
}

input TagUpdateInput {
    id:     ID!
    name:   String!
}

input TagIdOrNameInput {
    id:         ID
    name:       String
    entityType: EntityType
}