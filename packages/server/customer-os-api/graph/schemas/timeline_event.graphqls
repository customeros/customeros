union TimelineEvent = PageView | InteractionSession | Note | InteractionEvent | Issue | Meeting | Action | LogEntry | MarkdownEvent

extend type Query {
    timelineEvents(ids: [ID!]!): [TimelineEvent!]!
}

enum TimelineEventType {
    PAGE_VIEW
    INTERACTION_SESSION
    NOTE
    INTERACTION_EVENT
    ANALYSIS
    ISSUE
    MEETING
    ACTION
    LOG_ENTRY
    ORDER
    MARKDOWN_EVENT
}