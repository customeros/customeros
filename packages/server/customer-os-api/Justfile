proto_dir := "../proto"

help:
    @echo "Available commands:"
    @echo "  help        - Show this help message"
    @echo "  build       - Build the application"
    @echo "  debug       - Start application in debug mode using Delve"
    @echo "  gen-api     - Generate GraphQL code using gqlgen"
    @echo "  gen-proto-common - Generate Protobuf code for common module"
    @echo "  generate    - Run all code generation tasks"
    @echo "  run         - Run the application server"
    @echo "  test        - Run tests"
    @echo "  tidy        - Tidy and verify Go module dependencies"

build:
    go build .

debug:
    dlv debug customer_os_api_main.go

gen-api:
    go run github.com/99designs/gqlgen generate --config ./gqlgen.yml

gen-proto-common:
    find {{proto_dir}} -name "*.proto" -type f -exec \
    protoc \
    --proto_path={{proto_dir}} \
    --go_out=../customer-os-common-module/proto/pb \
    --go_opt=paths=source_relative \
    --go-grpc_out=../customer-os-common-module/proto/pb \
    --go-grpc_opt=module=github.com/customeros/customeros/packages/server/customer-os-common-module/proto/pb \
    {} \;

generate: gen-api gen-proto-common

run:
    go run customer_os_api_main.go

test:
    go test ./... -v

tidy:
    go mod tidy 