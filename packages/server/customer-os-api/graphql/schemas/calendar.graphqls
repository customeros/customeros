"""
Describes the relationship a Contact has with a Organization.
**A `return` object**
"""
type Calendar {
    id: ID!
    calType: CalendarType!
    createdAt: Time!
    updatedAt: Time!

    link: String
    primary: Boolean!

    source: DataSource!
    sourceOfTruth: DataSource! @deprecated
    appSource: String!
}

enum CalendarType {
    CALCOM,
    GOOGLE,
}

"""
Represents a time slot in calendar availability
"""
type TimeSlot {
    startTime: Time!
    endTime: Time!
    isAvailable: Boolean!
}

"""
Input for calendar availability query
"""
input CalendarAvailabilityInput {
    startTime:  Time!
    endTime:    Time!
    duration:   Int! # duration in minutes
    timezone:   String! # e.g. "America/New_York"
    email:      String # if provided, calendar availability for given email will be returned
}

"""
Response for calendar availability query
"""
type CalendarAvailabilityResponse {
    timeSlots: [TimeSlot!]!
    totalUsers: Int!
    availableUsers: Int!
}

extend type Query {
    """
    Get availability across all users in the tenant for a given time range
    """
    calendar_availability(input: CalendarAvailabilityInput!): CalendarAvailabilityResponse! @hasRole(roles: [ADMIN, USER]) @hasTenant

    """
    Get the Nylas account ID for a given email
    """
    getNylasAccountID(email: String!): String! @hasRole(roles: [ADMIN, USER]) @hasTenant
}

extend type Mutation {
    """
    Connect a user's email to Nylas calendar service
    """
    connectToNylas(email: String!): String! @hasRole(roles: [ADMIN, USER]) @hasTenant

    """
    Disconnect a user's email from Nylas calendar service
    """
    disconnectFromNylas(email: String!): Boolean! @hasRole(roles: [ADMIN, USER]) @hasTenant
}
