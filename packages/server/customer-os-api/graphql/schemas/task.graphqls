extend type Query {
    tasks: [Task!]! @hasRole(roles: [ADMIN, USER]) @hasTenant
}

extend type Mutation {
    task_Save(input: TaskInput!): Task! @hasRole(roles: [ADMIN, USER]) @hasTenant
}

input TaskInput {
    id              : ID
    subject         : String
    description     : String
    status          : TaskStatus
    asignees        : [ID!]
    opportunityIds  : [ID!]
    dueAt           : Time
}

type Task {
    id              : ID!
    subject         : String
    description     : String
    asignees        : [ID!]! @goField(forceResolver: true)
    authorId        : ID @goField(forceResolver: true)
    status          : TaskStatus!
    opportunityIds  : [ID!]! @goField(forceResolver: true)
    dueAt           : Time
    createdAt       : Time!
    updatedAt       : Time!
}

enum TaskStatus {
    TODO
    IN_PROGRESS
    DONE
}