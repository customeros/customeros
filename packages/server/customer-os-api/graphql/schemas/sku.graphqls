extend type Query {
    skus: [Sku!]! @hasRole(roles: [ADMIN, USER]) @hasTenant
}

extend type Mutation {
    sku_Save(input: SkuInput!): Sku! @hasRole(roles: [ADMIN, USER]) @hasTenant
    sku_Archive(id: ID!): Result! @hasRole(roles: [ADMIN, USER]) @hasTenant
}

input SkuInput {
    id: ID
    name: String!
    price: Float!
    type: SkuType!
}

type Sku {
    id:       ID!
    name:     String!
    price:    Float!
    type:     SkuType!
    archived: Boolean!
}

enum SkuType {
    SUBSCRIPTION
    ONE_TIME
}