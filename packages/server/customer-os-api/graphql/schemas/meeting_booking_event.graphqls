type MeetingBookingEvent {
    id:             String!
    createdAt:      Time!
    updatedAt:      Time!
    title:          String!
    durationMins:   Int64!
    description:    String!
    location:       String!
    participantEmails: [String!]!
    participants:      [MeetingBookingEventUserParticipant!]!

    bookingFormName:    String!
    bookingFormEmail:   String!
    bookingFormPhone:   String!
    bookingFormNameEnabled:    Boolean!
    bookingFormEmailEnabled:   Boolean!
    bookingFormPhoneEnabled:   Boolean!
    bookingFormPhoneRequired:  Boolean!

    bookOptionEnabled:                      Boolean!
    bookOptionBufferBetweenMeetingsMins:    Int64!
    bookOptionDaysInAdvance:                Int64!
    bookOptionMinNoticeMins:                Int64!

    assignmentMethod:                   MeetingBookingAssignmentMethod!
    emailNotificationEnabled:           Boolean!
    bookingConfirmationRedirectLink:    String!
    showLogo:                           Boolean!

}

enum MeetingBookingAssignmentMethod {
    ROUND_ROBIN_MAX_AVAILABILITY
    CUSTOM
}

input SaveMeetingBookingEventInput {
    id:             String
    title:          String
    durationMins:   Int64
    description:    String
    location:       String
    bookingFormNameEnabled:    Boolean
    bookingFormEmailEnabled:   Boolean
    bookingFormPhoneEnabled:   Boolean
    bookingFormPhoneRequired:  Boolean
    bookOptionEnabled:                      Boolean
    bookOptionBufferBetweenMeetingsMins:    Int64
    bookOptionDaysInAdvance:                Int64
    bookOptionMinNoticeMins:                Int64
    emailNotificationEnabled:               Boolean
    bookingConfirmationRedirectLink:        String
    showLogo:                               Boolean
    assignmentMethod:                       MeetingBookingAssignmentMethod
    participantEmails:                      [String!]
}

type MeetingBookingEventUserParticipant {
    id:                 ID!
    email:              String!
    name:               String!
    profilePhotoUrl:    String!
    connected:          Boolean!
}

extend type Query {
    meetingBookingEvents: [MeetingBookingEvent!]!
    participantsForMeetingBookingEvent: [MeetingBookingEventUserParticipant!]!
}

extend type Mutation {
    meetingBookingEvent_Save(input: SaveMeetingBookingEventInput!): MeetingBookingEvent!
}
