NEO4J_TARGET: neo4j://127.0.0.1:7687
NEO4J_AUTH_USER: neo4j
NEO4J_AUTH_PWD: password
NEO4J_AUTH_REALM:
NEO4J_MAX_CONN_POOL_SIZE: 100
# valid log values (ERROR, WARNING, INFO, DEBUG)
NEO4J_LOG_LEVEL: WARNING

POSTGRES_USER: postgres
POSTGRES_PASSWORD: password
POSTGRES_DB: openline
POSTGRES_HOST: 127.0.0.1
POSTGRES_PORT: 5555
POSTGRES_MAX_CONN: 100
POSTGRES_MAX_IDLE_CONN: 10
POSTGRES_CONN_MAX_LIFETIME: 0
POSTGRES_LOG_LEVEL: INFO

# valid log values (PANIC, FATAL, ERROR, WARN, INFO, DEBUG)
LOGGER_LEVEL: DEBUG
LOGGER_DEV_MODE: true
LOGGER_ENCODER: console

CRON_SCHEDULE_NEO4J_INTEGRITY_CHECKER: "0 0 */1 * * *"

AWS_REGION: eu-west-2
AWS_S3_BUCKET: openline-integrity-checker
AWS_CLOUDWATCH_METRICS_DIMENSION_ENVIRONMENT: openline-local

OTEL_ENABLED=true
OTEL_ENDPOINT=localhost:4320
OTEL_SERVICE_NAME=integrity-checker
OTEL_TIMEOUT=10