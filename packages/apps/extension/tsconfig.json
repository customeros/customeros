{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",

    "paths": {
      "@ui/*": ["./src/sidepanel/ui/*"],
      "@ui/form/*": ["src/sidepanel/ui/form/*"]
    }
  },
  "include": ["src/**/*.ts", "src/sidepanel/App.tsx"],
  "exclude": ["node_modules"]
}
